									"pm.test('HTTP 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Result true', function () {",
									"    pm.expect(pm.response.text()).to.include('<MarcacionRequisitosRegistraduriaResult>true</MarcacionRequisitosRegistraduriaResult>');",
									"});",
									"",
									"pm.test('Todos los requisitos actualizados', function () {",
									"    var body = pm.response.text();",
									"    ['IDEXPE', 'CORNEC', 'ESTREG', 'CEDULA'].forEach(function (sigla) {",
