							"listen": "test",
							"script": {
								"exec": [
									"pm.test('HTTP 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('codigo_estado 200 en el body', function () {",
									"    pm.expect(pm.response.json().codigo_estado).to.eql(200);",
									"});",
									"",
									"pm.test('Incluye estadoConsulta', function () {",
									"    pm.expect(pm.response.json()).to.have.property('estadoConsulta');",
